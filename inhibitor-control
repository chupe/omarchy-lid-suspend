#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: inhibitor-control hold|release"
}

mode=${1:-}
case "$mode" in
  hold | release) ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/"$(id -u)"}
state_dir="$runtime_dir/chupe.lid-suspend"
lock_file="$state_dir/inhibitor.lock"
unit=chupe.lid-suspend-inhibit.service

if [[ ${2:-} != --locked ]]; then
  mkdir -p "$state_dir"
  exec flock "$lock_file" bash "$0" "$mode" --locked
fi

case "$mode" in
  hold)
    if ! systemctl --user is-active --quiet "$unit"; then
      load_state=$(systemctl --user show --property=LoadState --value "$unit")
      if [[ $load_state != not-found ]]; then
        systemctl --user reset-failed "$unit"
      fi
      systemd-run --user --quiet --collect --unit="$unit" \
        --description="Omarchy Lid Suspend: Ignore Lid Close is on" \
        systemd-inhibit --what=handle-lid-switch --who="Omarchy Lid Suspend" \
          --why="Ignore Lid Close is on" --mode=block sleep infinity
    fi
    ;;
  release)
    load_state=$(systemctl --user show --property=LoadState --value "$unit")
    if [[ $load_state != not-found ]]; then
      systemctl --user stop --quiet "$unit"
    fi
    ;;
esac

if systemctl --user is-active --quiet "$unit"; then
  echo held
else
  echo released
fi
