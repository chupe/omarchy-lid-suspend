#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: uninstall-cleanup"
}

case "${1:-}" in
  "")
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

omarchy-toggle lid-suspend-off off
omarchy plugin disable chupe.lid-suspend

bash "$script_dir/inhibitor-control" release
bash "$script_dir/lid-power-profile" open
